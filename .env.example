# ============================================================================
# Oraya SaaS — environment template. Copy to `.env.local` and fill real values.
# NEVER commit real secrets. `.env.local` is gitignored; this file is not.
# ============================================================================

# ─── Supabase (Ora project) ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
# Optional structured-logger minimum level: debug | info | warn | error
LOG_LEVEL=debug

# ─── Superadmin auth ─────────────────────────────────────────────────────────
JWT_SECRET=change-me

# ─── AI provider key encryption (BYOK) ──────────────────────────────────────
# Used to decrypt user_ai_providers.api_key_encrypted (aes-256-cbc). The runtime
# resolves the key as: AI_PROVIDER_ENCRYPTION_KEY -> NEXTAUTH_SECRET -> (insecure
# hardcoded default). Set AI_PROVIDER_ENCRYPTION_KEY in every real environment.
AI_PROVIDER_ENCRYPTION_KEY=your-32b-provider-encryption-key
# ENCRYPTION_KEY is the historical name for the same secret in some tooling.
ENCRYPTION_KEY=your-32b-provider-encryption-key

# ─── Ed25519 license signing (desktop activation) ───────────────────────────
LICENSE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LICENSE_SIGNING_KEY_ID=v1

# ============================================================================
# Sovereign gateway (myoraya.space) — NEW in chatbot Phase 1b (plan 029)
# ----------------------------------------------------------------------------
# Powers BOTH orchestrated inference (Sentra, /api/v1/chat/completions) and web
# RAG embeddings (Qwen3-Embedding-0.6B, /api/v1/embeddings, 1024d).
#
#   • Inference: used ONLY when a widget opts in (config.use_sovereign_gateway).
#     If a widget opts in but these are unset, the chat route FAILS LOUD (503) —
#     it never silently falls back and hides the misconfiguration.
#   • RAG/embeddings + memory recall: enabled whenever BOTH vars below are set.
#     If unset, RAG degrades to 'off' (widgets keep working exactly as before);
#     it NEVER fabricates a hash/fake embedding.
#
# Both require a valid ORAK key. Do NOT hardcode the key anywhere in code.
# ============================================================================
ORAYA_GATEWAY_URL=https://myoraya.space
ORAYA_GATEWAY_ORAK_KEY=orak_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional — defaults to Qwen3-Embedding-0.6B (must match the vector(1024) columns).
ORAYA_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
