# ============================================================================
# Oraya SaaS — environment template. Copy to `.env.local` and fill real values.
# NEVER commit real secrets. `.env.local` is gitignored; this file is not.
# ============================================================================

# ─── Supabase (Ora project) ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
# Optional structured-logger minimum level: debug | info | warn | error
LOG_LEVEL=debug

# ─── Superadmin auth ─────────────────────────────────────────────────────────
JWT_SECRET=change-me

# ─── AI provider key encryption (BYOK) ──────────────────────────────────────
# Used to decrypt user_ai_providers.api_key_encrypted (aes-256-cbc). The runtime
# resolves the key as: AI_PROVIDER_ENCRYPTION_KEY -> NEXTAUTH_SECRET -> (insecure
# hardcoded default). Set AI_PROVIDER_ENCRYPTION_KEY in every real environment.
AI_PROVIDER_ENCRYPTION_KEY=your-32b-provider-encryption-key
# ENCRYPTION_KEY is the historical name for the same secret in some tooling.
ENCRYPTION_KEY=your-32b-provider-encryption-key

# ─── Ed25519 license signing (desktop activation) ───────────────────────────
LICENSE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LICENSE_SIGNING_KEY_ID=v1

# ============================================================================
# Sovereign gateway / embedder — PER-WIDGET, NOT a global env var.
# ----------------------------------------------------------------------------
# There is NO ORAYA_GATEWAY_URL / ORAYA_GATEWAY_ORAK_KEY / ORAYA_EMBEDDING_MODEL
# platform env var. The sovereign gateway (orchestrated chat + embeddings) is
# resolved DYNAMICALLY PER WIDGET/TENANT from that widget's OWN provider config:
#
#   • base URL + ORAK key  → the widget's `user_ai_providers` row (base_url +
#                            encrypted api_key), selected via the widget editor.
#   • chat model           → widget config.model (explicit).
#   • embedding model      → widget config.embedding_model (explicit).
#
# If a widget has no such provider + explicit embedding model configured, RAG +
# embeddings + memory are honestly OFF for that widget (fail-loud / degraded) —
# never a silent substitution to a platform host/key/model.
# ============================================================================
